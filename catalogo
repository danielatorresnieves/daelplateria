<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dael Platería — Mockup Web</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --verde: #1C3A2A;
    --verde-medio: #2A5240;
    --verde-claro: #3D6B54;
    --plata: #B8BAB6;
    --plata-clara: #D8DAD6;
    --negro: #0C0C0C;
    --blanco: #F8F7F4;
    --crema: #F2F0EB;
    --gris-suave: #E8E6E1;
    --texto-secundario: #5A5A5A;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Jost', sans-serif;
    background: var(--negro);
    color: var(--blanco);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.5rem 4rem;
    background: rgba(12,12,12,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 0.5px solid rgba(184,186,182,0.2);
  }
  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem; font-weight: 400; letter-spacing: 0.2em;
    color: var(--plata-clara);
    text-transform: uppercase;
  }
  .nav-logo span { color: var(--plata); font-weight: 300; }
  .nav-links { display: flex; gap: 2.5rem; }
  .nav-links a {
    text-decoration: none; color: rgba(248,247,244,0.65);
    font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 400; transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--plata-clara); }
  .nav-cta {
    font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase;
    font-weight: 400; padding: 0.6rem 1.4rem;
    border: 0.5px solid var(--plata);
    color: var(--plata); text-decoration: none;
    transition: all 0.3s;
  }
  .nav-cta:hover { background: var(--plata); color: var(--negro); }

  /* ── HERO ── */
  #hero {
    height: 100vh; min-height: 640px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    position: relative; overflow: hidden;
    background: var(--negro);
    text-align: center; padding: 2rem;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 40%, rgba(28,58,42,0.55) 0%, transparent 70%),
      radial-gradient(ellipse 30% 40% at 20% 80%, rgba(28,58,42,0.2) 0%, transparent 60%);
  }
  .hero-ornamento {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.65rem; letter-spacing: 0.4em; text-transform: uppercase;
    color: var(--plata); font-weight: 300; margin-bottom: 2.5rem;
    display: flex; align-items: center; gap: 1.5rem;
  }
  .hero-ornamento::before, .hero-ornamento::after {
    content: ''; width: 48px; height: 0.5px; background: var(--plata); opacity: 0.5;
  }
  .hero-titulo {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    font-weight: 300; line-height: 0.95;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blanco); position: relative; z-index: 1;
  }
  .hero-titulo .acento { color: var(--plata); font-style: italic; font-weight: 300; }
  .hero-slogan {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem; letter-spacing: 0.35em; text-transform: uppercase;
    color: rgba(184,186,182,0.75); font-weight: 300;
    margin-top: 2rem; position: relative; z-index: 1;
  }
  .hero-frase {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem; font-weight: 300; font-style: italic;
    color: rgba(248,247,244,0.55); margin-top: 0.8rem;
    position: relative; z-index: 1;
  }
  .hero-btns {
    margin-top: 3.5rem; display: flex; gap: 1.2rem;
    position: relative; z-index: 1; flex-wrap: wrap; justify-content: center;
  }
  .btn-principal {
    padding: 0.9rem 2.5rem; background: var(--verde);
    color: var(--blanco); text-decoration: none;
    font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase;
    font-weight: 400; border: 0.5px solid var(--verde-claro);
    transition: all 0.3s;
  }
  .btn-principal:hover { background: var(--verde-medio); }
  .btn-secundario {
    padding: 0.9rem 2.5rem; background: transparent;
    color: var(--plata); text-decoration: none;
    font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase;
    font-weight: 400; border: 0.5px solid var(--plata);
    transition: all 0.3s;
  }
  .btn-secundario:hover { background: rgba(184,186,182,0.1); }
  .hero-scroll {
    position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%);
    font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(184,186,182,0.4); display: flex; flex-direction: column;
    align-items: center; gap: 0.8rem;
  }
  .hero-scroll::after {
    content: ''; width: 0.5px; height: 40px; background: rgba(184,186,182,0.3);
    animation: scroll-line 2s ease-in-out infinite;
  }
  @keyframes scroll-line {
    0%,100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 0.8; transform: scaleY(0.6); }
  }

  /* ── SEPARADOR ── */
  .sep {
    display: flex; align-items: center; justify-content: center;
    gap: 1rem; padding: 1.5rem 4rem;
    background: var(--negro);
  }
  .sep-line { flex: 1; height: 0.5px; background: rgba(184,186,182,0.15); }
  .sep-icon {
    font-family: 'Cormorant Garamond', serif;
    color: var(--plata); font-size: 1rem; opacity: 0.5;
  }

  /* ── SOBRE DAEL ── */
  #sobre {
    background: var(--negro);
    padding: 8rem 4rem; display: grid;
    grid-template-columns: 1fr 1fr; gap: 6rem;
    align-items: center; max-width: 1200px; margin: 0 auto;
  }
  .sobre-img-wrap {
    position: relative; aspect-ratio: 3/4;
    background: var(--verde);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .sobre-img-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(145deg, var(--verde) 0%, var(--verde-medio) 60%, #0C1F16 100%);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1rem;
  }
  .libro-svg {
    opacity: 0.3;
  }
  .sobre-badge {
    position: absolute; bottom: -1px; right: -1px;
    background: var(--negro); padding: 1.2rem 1.8rem;
    border: 0.5px solid rgba(184,186,182,0.2);
  }
  .sobre-badge-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.5rem; font-weight: 300; color: var(--plata);
    line-height: 1;
  }
  .sobre-badge-txt {
    font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(184,186,182,0.55); font-weight: 300;
  }
  .sobre-content { display: flex; flex-direction: column; gap: 2rem; }
  .seccion-label {
    font-size: 0.62rem; letter-spacing: 0.4em; text-transform: uppercase;
    color: var(--plata); font-weight: 400;
    display: flex; align-items: center; gap: 1rem;
  }
  .seccion-label::after {
    content: ''; width: 32px; height: 0.5px; background: var(--plata); opacity: 0.5;
  }
  .seccion-titulo {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3rem); font-weight: 300;
    line-height: 1.2; color: var(--blanco);
  }
  .seccion-titulo em { font-style: italic; color: var(--plata); }
  .sobre-texto {
    color: rgba(248,247,244,0.55); font-size: 0.9rem;
    line-height: 1.9; font-weight: 300;
  }
  .sobre-valores {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
    margin-top: 0.5rem;
  }
  .valor-item {
    padding: 1.2rem; border: 0.5px solid rgba(184,186,182,0.15);
    display: flex; flex-direction: column; gap: 0.4rem;
  }
  .valor-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem; color: var(--plata); font-weight: 300;
  }
  .valor-txt {
    font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(248,247,244,0.45); font-weight: 300;
  }

  /* ── CATALOGO ── */
  #catalogo {
    background: var(--crema); color: var(--negro);
    padding: 8rem 4rem;
  }
  .catalogo-header {
    max-width: 1200px; margin: 0 auto 4rem;
    display: flex; align-items: flex-end; justify-content: space-between;
  }
  .catalogo-header .seccion-label { color: var(--verde); }
  .catalogo-header .seccion-label::after { background: var(--verde); }
  .catalogo-header .seccion-titulo { color: var(--negro); }
  .catalogo-header .seccion-titulo em { color: var(--verde-medio); }
  .catalogo-filtros {
    display: flex; gap: 1rem; align-items: center;
  }
  .filtro-btn {
    padding: 0.5rem 1.2rem;
    border: 0.5px solid rgba(28,58,42,0.25);
    background: transparent; color: var(--verde);
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;
    cursor: pointer; transition: all 0.3s; font-weight: 400;
  }
  .filtro-btn.active, .filtro-btn:hover {
    background: var(--verde); color: var(--blanco);
    border-color: var(--verde);
  }
  .catalogo-grid {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;
  }
  .producto-card {
    background: var(--blanco); border: 0.5px solid rgba(28,58,42,0.1);
    transition: transform 0.4s, box-shadow 0.4s; cursor: pointer;
    position: relative; overflow: hidden;
  }
  .producto-card:hover { transform: translateY(-4px); box-shadow: 0 20px 60px rgba(28,58,42,0.12); }
  .producto-img {
    aspect-ratio: 1; background: var(--gris-suave);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; position: relative;
  }
  .producto-img-inner {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 3rem; color: rgba(28,58,42,0.15);
    font-style: italic;
  }
  .producto-badge-new {
    position: absolute; top: 1rem; left: 1rem;
    background: var(--verde); color: var(--blanco);
    font-size: 0.55rem; letter-spacing: 0.2em; text-transform: uppercase;
    padding: 0.3rem 0.8rem; font-weight: 400;
  }
  .producto-info {
    padding: 1.5rem;
    border-top: 0.5px solid rgba(28,58,42,0.08);
  }
  .producto-categoria {
    font-size: 0.58rem; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--verde-medio); font-weight: 400; margin-bottom: 0.5rem;
  }
  .producto-nombre {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem; font-weight: 400; color: var(--negro);
    margin-bottom: 0.3rem; line-height: 1.3;
  }
  .producto-desc {
    font-size: 0.75rem; color: var(--texto-secundario);
    margin-bottom: 1.2rem; line-height: 1.7; font-weight: 300;
  }
  .producto-footer {
    display: flex; align-items: center; justify-content: space-between;
  }
  .producto-precio {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem; font-weight: 500; color: var(--negro);
  }
  .producto-ley {
    font-size: 0.58rem; color: var(--texto-secundario); display: block;
    letter-spacing: 0.1em;
  }
  .btn-wa {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.6rem 1rem; background: var(--verde);
    color: var(--blanco); text-decoration: none;
    font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase;
    font-weight: 400; border: none; cursor: pointer; transition: background 0.3s;
  }
  .btn-wa:hover { background: var(--verde-medio); }
  .wa-icon { width: 14px; height: 14px; }

  /* ── COMO COMPRAR ── */
  #proceso {
    background: var(--negro); padding: 8rem 4rem;
  }
  .proceso-inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 8rem; align-items: center;
  }
  .proceso-content { display: flex; flex-direction: column; gap: 2.5rem; }
  .proceso-pasos { display: flex; flex-direction: column; gap: 0; }
  .paso {
    display: flex; gap: 2rem; padding: 2rem 0;
    border-bottom: 0.5px solid rgba(184,186,182,0.1);
    align-items: flex-start;
  }
  .paso:first-child { border-top: 0.5px solid rgba(184,186,182,0.1); }
  .paso-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.5rem; font-weight: 300; color: rgba(184,186,182,0.25);
    line-height: 1; min-width: 2.5rem;
  }
  .paso-txt { flex: 1; }
  .paso-titulo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem; font-weight: 400; color: var(--blanco);
    margin-bottom: 0.4rem;
  }
  .paso-desc {
    font-size: 0.8rem; color: rgba(248,247,244,0.45);
    line-height: 1.8; font-weight: 300;
  }
  .proceso-visual {
    background: var(--verde);
    aspect-ratio: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 2rem;
    padding: 3rem; text-align: center;
    border: 0.5px solid var(--verde-claro);
  }
  .proceso-visual-titulo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem; font-weight: 300; color: rgba(248,247,244,0.9);
    line-height: 1.3; font-style: italic;
  }
  .proceso-visual-sub {
    font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase;
    color: rgba(248,247,244,0.5); font-weight: 300;
  }
  .proceso-wa-btn {
    display: inline-flex; align-items: center; gap: 0.8rem;
    padding: 1rem 2rem; background: rgba(0,0,0,0.25);
    color: var(--blanco); text-decoration: none;
    font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase;
    font-weight: 400; border: 0.5px solid rgba(248,247,244,0.3);
    transition: all 0.3s;
  }
  .proceso-wa-btn:hover { background: rgba(0,0,0,0.4); }

  /* ── CUIDADOS ── */
  #cuidados {
    background: var(--crema); color: var(--negro); padding: 7rem 4rem;
  }
  .cuidados-inner {
    max-width: 1200px; margin: 0 auto;
  }
  .cuidados-header {
    text-align: center; margin-bottom: 4rem;
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
  }
  .cuidados-header .seccion-label { color: var(--verde); }
  .cuidados-header .seccion-label::after { background: var(--verde); opacity: 0.5; }
  .cuidados-header .seccion-titulo { color: var(--negro); text-align: center; }
  .cuidados-header .seccion-titulo em { color: var(--verde-medio); }
  .cuidados-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: rgba(28,58,42,0.1);
    border: 0.5px solid rgba(28,58,42,0.1);
  }
  .cuidado-item {
    background: var(--crema); padding: 2.5rem 2rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: background 0.3s;
  }
  .cuidado-item:hover { background: var(--blanco); }
  .cuidado-icon {
    width: 36px; height: 36px; opacity: 0.5;
    color: var(--verde);
  }
  .cuidado-titulo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem; font-weight: 400; color: var(--negro);
  }
  .cuidado-desc {
    font-size: 0.78rem; color: var(--texto-secundario);
    line-height: 1.8; font-weight: 300;
  }

  /* ── TESTIMONIO ── */
  #testimonio {
    background: var(--verde); padding: 8rem 4rem;
    text-align: center; position: relative; overflow: hidden;
  }
  #testimonio::before {
    content: '"';
    position: absolute; top: -2rem; left: 50%; transform: translateX(-50%);
    font-family: 'Cormorant Garamond', serif;
    font-size: 20rem; font-weight: 300; color: rgba(0,0,0,0.08); line-height: 1;
    pointer-events: none;
  }
  .testimonio-inner {
    max-width: 700px; margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 2rem;
    position: relative; z-index: 1;
  }
  .testimonio-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 300; font-style: italic;
    color: rgba(248,247,244,0.92); line-height: 1.5;
  }
  .testimonio-autor {
    font-size: 0.65rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(248,247,244,0.5); font-weight: 300;
    display: flex; align-items: center; gap: 1rem;
  }
  .testimonio-autor::before, .testimonio-autor::after {
    content: ''; width: 24px; height: 0.5px; background: rgba(248,247,244,0.3);
  }

  /* ── CONTACTO / FOOTER ── */
  #contacto {
    background: var(--negro); padding: 7rem 4rem 4rem;
  }
  .contacto-inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 6rem;
    padding-bottom: 5rem;
    border-bottom: 0.5px solid rgba(184,186,182,0.1);
  }
  .contacto-left { display: flex; flex-direction: column; gap: 2rem; }
  .contacto-titulo {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3rem); font-weight: 300;
    color: var(--blanco); line-height: 1.2;
  }
  .contacto-titulo em { font-style: italic; color: var(--plata); }
  .contacto-desc {
    font-size: 0.85rem; color: rgba(248,247,244,0.5);
    line-height: 1.9; font-weight: 300;
  }
  .contacto-btns { display: flex; flex-direction: column; gap: 1rem; }
  .btn-wa-grande {
    display: flex; align-items: center; gap: 1rem;
    padding: 1.2rem 2rem; background: #25D366; color: #fff;
    text-decoration: none; font-size: 0.7rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    font-weight: 400; transition: all 0.3s; max-width: 280px;
  }
  .btn-wa-grande:hover { background: #20B859; }
  .btn-instagram {
    display: flex; align-items: center; gap: 1rem;
    padding: 1.2rem 2rem; background: transparent; color: var(--plata);
    text-decoration: none; font-size: 0.7rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    font-weight: 400; border: 0.5px solid var(--plata);
    transition: all 0.3s; max-width: 280px;
  }
  .btn-instagram:hover { background: rgba(184,186,182,0.1); }
  .contacto-right { display: flex; flex-direction: column; gap: 2rem; }
  .contacto-info-item {
    padding: 1.8rem; border: 0.5px solid rgba(184,186,182,0.12);
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .contacto-info-label {
    font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--plata); font-weight: 400;
  }
  .contacto-info-val {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem; color: var(--blanco); font-weight: 300;
  }
  .footer-bottom {
    max-width: 1200px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 3rem; flex-wrap: wrap; gap: 1.5rem;
  }
  .footer-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem; font-weight: 400; letter-spacing: 0.2em;
    color: var(--plata-clara); text-transform: uppercase;
  }
  .footer-copy {
    font-size: 0.62rem; color: rgba(184,186,182,0.3);
    letter-spacing: 0.1em; font-weight: 300;
  }
  .footer-frase {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.85rem; font-style: italic;
    color: rgba(184,186,182,0.35); font-weight: 300;
  }

  /* ── NOTA GUIA ── */
  .nota-guia {
    position: fixed; bottom: 2rem; right: 2rem;
    background: var(--verde); color: var(--blanco);
    padding: 1rem 1.5rem; font-size: 0.68rem;
    letter-spacing: 0.1em; max-width: 260px;
    border: 0.5px solid var(--verde-claro);
    line-height: 1.6; z-index: 200;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }
  .nota-guia strong { font-weight: 500; display: block; margin-bottom: 0.3rem; }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-logo">Dael <span>Platería</span></div>
  <div class="nav-links">
